    resolve_service_order "$env" ordered "${services[@]}"

    echo -e "${BLUE}Initializing ${env_name} services...${NC}"
    echo -e "${YELLOW}Services:${NC} ${services[*]}"
    echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

    for service in "${ordered[@]}"; do
