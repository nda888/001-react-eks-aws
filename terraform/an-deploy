run_destroy_command() {
    local env="$1"
    shift
    local services=()
    local all_services=()
    local ordered=()
    local destroy_order=()
    local env_name
    local service
    local has_failure=0
    local arg

    env_name="$(env_upper "$env")"

    get_services "$env" all_services
    if [[ ${#all_services[@]} -eq 0 ]]; then
        echo -e "${RED}ERROR: No services found for env '$env'${NC}"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        echo -e "${RED}ERROR: At least one service is required${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy ${env}-destroy <service1> [service2] | all | bootstrap${NC}"
        return 1
    fi

    for arg in "$@"; do
        if [[ "$arg" == "bootstrap" ]]; then
            if [[ $# -gt 1 ]]; then
                echo -e "${RED}ERROR: 'bootstrap' selector must be used alone${NC}"
                echo -e "${YELLOW}Usage: ./an-deploy ${env}-destroy <service1> [service2] | all | bootstrap${NC}"
                return 1
            fi

            run_env_bootstrap_destroy_command "$env"
            return $?
        fi

        if [[ "$arg" == "all" || "$arg" == "ALL" || "$arg" == "*" ]]; then
            if [[ $# -gt 1 ]]; then
                echo -e "${RED}ERROR: 'all' selector must be used alone${NC}"
                echo -e "${YELLOW}Usage: ./an-deploy ${env}-destroy <service1> [service2] | all | bootstrap${NC}"
                return 1
            fi

            services=("${all_services[@]}")
            validate_uat_blocked_services "$env" "${services[@]}" || return 1
            resolve_service_order "$env" ordered "${services[@]}"
            reverse_services destroy_order "${ordered[@]}"

            echo -e "${RED}Destroying all ${env_name} services...${NC}"
            echo -e "${YELLOW}Destroy order:${NC} ${destroy_order[*]}"

            echo -en "Type '${RED}DESTROY ALL${NC}' to ${RED}confirm${NC}: "
            read -r confirm
            if [[ "$confirm" != "DESTROY ALL" ]]; then
                echo -e "${YELLOW}Operation cancelled${NC}"
                return 1
            fi

            for service in "${destroy_order[@]}"; do
                if ! run_service_destroy "$env" "$service"; then
                    has_failure=1
                    echo -e "${RED}Failed to destroy service: ${env}/${service}${NC}"
                fi
            done

            if [[ $has_failure -eq 1 ]]; then
                echo -e "${RED}------ ${env_name} destroy completed with errors${NC}"
                return 1
            fi

            echo -en "Clean up bootstrap backend state for ${env_name}? (y/n): "
            read -r cleanup_bootstrap
            if [[ "$cleanup_bootstrap" == "y" || "$cleanup_bootstrap" == "Y" ]]; then
                run_env_bootstrap_destroy_command "$env" || return $?
            fi

            echo -e "${GREEN}====== ${env_name} destroy completed!${NC}"
            return 0
        fi
    done

    validate_uat_blocked_services "$env" "$@" || return 1
    validate_multi_service_args "$env" "${env}-destroy" "$MAX_MULTI_SERVICE" services "$@" || return 1
    resolve_service_order "$env" ordered "${services[@]}"
    reverse_services destroy_order "${ordered[@]}"

    echo -e "${RED}Destroying ${env_name} services...${NC}"
    echo -e "${YELLOW}Services:${NC} ${services[*]}"
    echo -e "${YELLOW}Destroy order:${NC} ${destroy_order[*]}"

    echo -en "Type '${RED}DESTROY${NC}' to confirm: "
    read -r confirm
    if [[ "$confirm" != "DESTROY" ]]; then
        echo -e "${YELLOW}Operation cancelled${NC}"
        return 1
    fi

    for service in "${destroy_order[@]}"; do
        if ! run_service_destroy "$env" "$service"; then
            has_failure=1
            echo -e "${RED}Failed to destroy service: ${env}/${service}${NC}"
        fi
    done

    if [[ $has_failure -eq 1 ]]; then
        echo -e "${RED}------ ${env_name} destroy completed with errors${NC}"
        return 1
    fi

    echo -e "${GREEN}====== ${env_name} destroy completed!${NC}"
}

