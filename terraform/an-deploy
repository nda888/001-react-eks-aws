        print_terraform_command "terraform -chdir=$dir plan -out=$tfplan"
        terraform -chdir="$dir" plan -out="$tfplan"
    fi

    echo -e "${GREEN}Plan saved to: $(plan_path "$env" "$service")${NC}"
}

