run_apply_command() {
    local env="$1"
    shift
    local targets=()
    local ordered=()
    local env_name
    local service

    env_name="$(env_upper "$env")"
    validate_uat_blocked_services "$env" "$@" || return 1
    collect_env_targets "$env" "${env}-apply" targets "$@" || return 1
    resolve_service_order "$env" ordered "${targets[@]}"
    expand_deploy_targets "$env" ordered "${ordered[@]}"

    for service in "${ordered[@]}"; do
        [[ -f "$(plan_path "$env" "$service")" ]] || {
            echo -e "${RED}ERROR: Missing plan for ${env}/${service}${NC}"
            echo -e "${YELLOW}Run: ./an-deploy ${env}-plan $service${NC}"
            return 1
        }
    done

    echo -e "${BLUE}Applying ${env_name} services...${NC}"
    echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

    read -r -p "Apply planned changes for ${env_name}? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Operation cancelled${NC}"
        return 1
    fi

    for service in "${ordered[@]}"; do
        run_service_apply "$env" "$service"
    done

    echo -e "${GREEN}====== ${env_name} apply completed!${NC}"
}

parse_env_deploy_flags() {
    local env="$1"
    shift

    DRY_RUN=0
    cleaned_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            "-y")
                AUTO_YES=1
                ;;
            "--dry-run")
                DRY_RUN=1
                ;;
            -*)
                echo -e "${RED}ERROR: Unsupported option for ./an-deploy ${env}: $1${NC}"
                echo -e "${YELLOW}Usage: ./an-deploy ${env} <service1> [service2] | all [-y] [--dry-run]${NC}"
                return 1
                ;;
            *)
                cleaned_args+=("$1")
                ;;
        esac
        shift
    done
}

run_deploy_command() {
    local env="$1"
    shift

    parse_env_deploy_flags "$env" "$@" || return 1
    # Use cleaned_args instead of "$@" for service checks
    set -- "${cleaned_args[@]}"

    local services=()
    local all_services=()
    local ordered=()
    local env_name
    local service
    local arg

    env_name="$(env_upper "$env")"

    get_services "$env" all_services
    if [[ ${#all_services[@]} -eq 0 ]]; then
        echo -e "${RED}ERROR: No services found for env '$env'${NC}"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        echo -e "${RED}ERROR: At least one service is required${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy ${env} <service1> [service2] | all [-y] [--dry-run]${NC}"
        return 1
    fi

    for arg in "$@"; do
        if [[ "$arg" == "all" || "$arg" == "ALL" || "$arg" == "*" ]]; then
            if [[ $# -gt 1 ]]; then
                echo -e "${RED}ERROR: 'all' selector must be used alone${NC}"
                echo -e "${YELLOW}Usage: ./an-deploy ${env} <service1> [service2] | all [-y] [--dry-run]${NC}"
                return 1
            fi
            services=("${all_services[@]}")
            validate_uat_blocked_services "$env" "${services[@]}" || return 1
            resolve_service_order "$env" ordered "${services[@]}"
            expand_deploy_targets "$env" ordered "${ordered[@]}"

            if [[ "${DRY_RUN:-0}" -eq 1 ]]; then
                echo -e "${BLUE}[DRY-RUN] Planning all ${env_name} services...${NC}"
                echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

                if ! confirm_yes_no "Run plan for all ${env_name} services? (y/n): "; then
                    echo -e "${YELLOW}Operation cancelled${NC}"
                    return 1
                fi

                for service in "${ordered[@]}"; do
                    run_service_plan "$env" "$service"
                done

                echo -e "${GREEN}====== ${env_name} dry-run completed!${NC}"
                return 0
            fi

            echo -e "${BLUE}Deploying all ${env_name} services...${NC}"
            echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

            if ! confirm_yes_no "Run plan + apply sequentially for all ${env_name} services? (y/n): "; then
                echo -e "${YELLOW}Operation cancelled${NC}"
                return 1
            fi

            for service in "${ordered[@]}"; do
                run_service_plan "$env" "$service"
                run_service_apply "$env" "$service"
            done

            echo -e "${GREEN}====== ${env_name} deploy completed!${NC}"
            return 0
        fi
    done

    validate_uat_blocked_services "$env" "$@" || return 1
    validate_multi_service_args "$env" "${env}" "$MAX_MULTI_SERVICE" services "$@" || return 1
    resolve_service_order "$env" ordered "${services[@]}"
    expand_deploy_targets "$env" ordered "${ordered[@]}"

    if [[ "${DRY_RUN:-0}" -eq 1 ]]; then
        echo -e "${BLUE}[DRY-RUN] Planning ${env_name} services...${NC}"
        echo -e "${YELLOW}Services:${NC} ${services[*]}"
        echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

        if ! confirm_yes_no "Run plan for selected ${env_name} services? (y/n): "; then
            echo -e "${YELLOW}Operation cancelled${NC}"
            return 1
        fi

        for service in "${ordered[@]}"; do
            run_service_plan "$env" "$service"
        done

        echo -e "${GREEN}====== ${env_name} dry-run completed!${NC}"
        return 0
    fi

    echo -e "${BLUE}Deploying ${env_name} services...${NC}"
    echo -e "${YELLOW}Services:${NC} ${services[*]}"
    echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

    if ! confirm_yes_no "Run plan + apply sequentially for selected ${env_name} services? (y/n): "; then
        echo -e "${YELLOW}Operation cancelled${NC}"
        return 1
    fi

    for service in "${ordered[@]}"; do
        run_service_plan "$env" "$service"
        run_service_apply "$env" "$service"
    done

    echo -e "${GREEN}====== ${env_name} deploy completed!${NC}"
}

