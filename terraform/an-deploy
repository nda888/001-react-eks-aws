# ========================================
# Command Orchestration Functions
# ========================================
collect_env_targets() {
    local env="$1"
    local command_usage="$2"
    local out_name="$3"
    shift 3

    local -n out_ref="$out_name"
    local selected=()
    local all_services=()
    local arg

    out_ref=()

    get_services "$env" all_services
    if [[ ${#all_services[@]} -eq 0 ]]; then
        echo -e "${RED}ERROR: No services found for env '$env'${NC}"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        out_ref=("${all_services[@]}")
        return 0
    fi

    if [[ $# -gt 1 ]]; then
        for arg in "$@"; do
            if [[ "$arg" == "all" || "$arg" == "ALL" || "$arg" == "*" ]]; then
                echo -e "${RED}ERROR: 'all' selector must be used alone${NC}"
                echo -e "${YELLOW}Usage: ./an-deploy $command_usage [service|all]${NC}"
                return 1
            fi
        done
        echo -e "${RED}ERROR: Command supports only one service or 'all'${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy $command_usage [service|all]${NC}"
        return 1
    fi

    arg="$1"
    if [[ "$arg" == "all" || "$arg" == "ALL" || "$arg" == "*" ]]; then
        out_ref=("${all_services[@]}")
        return 0
    fi

    validate_service "$env" "$arg" || return 1
    out_ref=("$arg")
    return 0
}

run_validate_command() {
    local env="$1"
    shift
    local targets=()
    local ordered=()
    local env_name

    env_name="$(env_upper "$env")"
    collect_env_targets "$env" "${env}-validate" targets "$@" || return 1
    resolve_service_order "$env" ordered "${targets[@]}"

    echo -e "${BLUE}Validating ${env_name} services...${NC}"
    echo -e "${YELLOW}Order:${NC} ${ordered[*]}"

    for service in "${ordered[@]}"; do
        run_service_validate "$env" "$service"
    done

    echo -e "${GREEN}====== ${env_name} validation completed!${NC}"
}

run_init_command() {
