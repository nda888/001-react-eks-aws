# ========================================
# Main Execution
# ========================================
main() {
    local command="${1:-}"
    shift || true

    case "$command" in
        "be-init")
            validate_prerequisites || exit 1
            run_backend_init_command "$@"
            ;;
        "dev-init")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_init_command "dev" "$@"
            ;;
        "dev-validate")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_validate_command "dev" "$@"
            ;;
        "dev-plan")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_plan_command "dev" "$@"
            ;;
        "dev-apply")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_apply_command "dev" "$@"
            ;;
        "dev")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_deploy_command "dev" "$@"
            ;;
        "dev-destroy")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_destroy_command "dev" "$@"
            ;;
        "dev-svc-plan")
            validate_prerequisites || exit 1
            validate_environment "dev" || exit 1
            run_show_service_plan_command "dev" "$@"
            ;;
        "dev-get")
            run_dev_get_command "$@"
            ;;

        "uat-init")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_init_command "uat" "$@"
            ;;
        "uat-validate")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_validate_command "uat" "$@"
            ;;
        "uat-plan")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_plan_command "uat" "$@"
            ;;
        "uat-apply")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_apply_command "uat" "$@"
            ;;
        "uat")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_deploy_command "uat" "$@"
            ;;
        "uat-destroy")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_destroy_command "uat" "$@"
            ;;
        "uat-svc-plan")
            validate_prerequisites || exit 1
            validate_environment "uat" || exit 1
            run_show_service_plan_command "uat" "$@"
            ;;
        "uat-get")
            run_uat_get_command "$@"
            ;;

        "all")
            run_global_deploy_all_command "$@"
            ;;

        "destroy")
            run_global_destroy_all_command "$@"
            ;;

        "--help"|"")
            validate_no_args "--help" "$@" || exit 1
            show_help
            ;;
        "-h")
            validate_no_args "-h" "$@" || exit 1
            show_dev_help
            ;;
        "dev-help")
            validate_no_args "dev-help" "$@" || exit 1
            show_dev_help
            ;;
        "uat-help")
            validate_no_args "uat-help" "$@" || exit 1
            show_uat_help
            ;;

        *)
            echo -e "${RED}ERROR: Unknown command: $command${NC}"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
