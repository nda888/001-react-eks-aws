# ========================================
# Runtime Secret Retrieval Functions
# ========================================
fetch_k8s_secret_field() {
    local label="$1"
    local secret="$2"
    local key="$3"
    local namespace="$4"
    local encoded
    local decoded

    encoded="$(kubectl -n "$namespace" get secret "$secret" -o "jsonpath={.data.${key}}" 2>&1)" || {
        echo -e "${RED}ERROR: Failed to read ${label} or Non-Exist (kubectl error on secret '${secret}')${NC}"
        return 1
    }

    if [[ -z "$encoded" ]]; then
        echo -e "${RED}ERROR: Key '${key}' missing or empty in secret '${secret}'${NC}"
        return 1
    fi

    decoded="$(echo "$encoded" | base64 -d 2>&1)" || {
        echo -e "${RED}ERROR: Failed to decode ${label} (base64 error)${NC}"
        return 1
    }

    echo -e "${GREEN}${label}:${NC} ${decoded}"
}

print_mongodb_runtime_secrets_for_env() {
    local env="$1"
    local env_name

    env_name="$(env_upper "$env")"
    echo -e "${BLUE}Retrieving runtime MongoDB secrets from ${env} cluster...${NC}"
    echo ""
    echo -e "${BLUE}${env_name}:${NC}"
    fetch_k8s_secret_field "App Password" "mongo-app-secret" "MONGO_APP_PASSWORD" "$env" || return 1
    fetch_k8s_secret_field "Root Password" "mongo-root-secret" "MONGO_INITDB_ROOT_PASSWORD" "$env" || return 1
    fetch_k8s_secret_field "MongoDB URI" "mongo-app-secret" "MONGODB_URI" "$env" || return 1
}

# ========================================
# Dev Get (Runtime Info Retrieval) Functions
# ========================================
fetch_elb_dns_name() {
    local region="$1"
    local load_balancer_name="$2"
    local dns_name

    command -v aws >/dev/null 2>&1 || {
        echo -e "${RED}ERROR: aws CLI not installed${NC}" >&2
        return 1
    }

    dns_name="$(aws elbv2 describe-load-balancers \
        --region "$region" \
        --names "$load_balancer_name" \
        --query 'LoadBalancers[0].DNSName' \
        --output text 2>&1)" || {
        echo -e "${RED}ERROR: Failed to read ELB DNS name for '${load_balancer_name}'${NC}" >&2
        echo "$dns_name" >&2
        return 1
    }

    if [[ -z "$dns_name" || "$dns_name" == "None" ]]; then
        echo -e "${RED}ERROR: ELB DNS name not found for '${load_balancer_name}'${NC}" >&2
        return 1
    fi

    echo -e "${GREEN}DNS Name:${NC} ${dns_name}"
}

run_dev_get_command() {
    local target="${1:-}"
    shift || true

    if [[ -z "$target" ]]; then
        echo -e "${RED}ERROR: Missing required argument${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy dev-get <elb|mongodb>${NC}"
        return 1
    fi

    if [[ $# -gt 0 ]]; then
        echo -e "${RED}ERROR: Too many arguments${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy dev-get <elb|mongodb>${NC}"
        return 1
    fi

    validate_environment "dev" || return 1

    case "$target" in
        "elb")
            fetch_elb_dns_name "us-east-1" "demo-react-eks-dev-uat"
            ;;
        "mongodb")
            command -v kubectl >/dev/null 2>&1 || {
                echo -e "${RED}ERROR: kubectl not installed${NC}"
                return 1
            }
            print_mongodb_runtime_secrets_for_env "dev"
            ;;
        *)
            echo -e "${RED}ERROR: Unsupported target '${target}'${NC}"
            echo -e "${YELLOW}Supported: elb, mongodb${NC}"
            return 1
            ;;
    esac
}

