#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
ENVIRONMENTS=("dev" "uat")
MAX_MULTI_SERVICE=2
AUTO_YES=0
DRY_RUN=0

# ========================================
# Utility Functions
# ========================================
join_by() {
    local delimiter="$1"
    shift
    local first=1
    local item

    for item in "$@"; do
        if [[ $first -eq 1 ]]; then
            printf "%s" "$item"
            first=0
        else
            printf "%s%s" "$delimiter" "$item"
        fi
    done
}

array_contains() {
    local needle="$1"
    shift
    local item

    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done

    return 1
}

env_upper() {
    local env="$1"
    echo "${env^^}"
}

service_dir() {
    local env="$1"
    local service="$2"
    echo "envs/$env/services/$service"
}

plan_name() {
    local service="$1"
    echo "${service}-tfplan"
}

plan_path() {
    local env="$1"
    local service="$2"
    echo "$(service_dir "$env" "$service")/$(plan_name "$service")"
}

print_terraform_command() {
    local cmd="$1"
    echo -e "${YELLOW}Command: ${PURPLE}${cmd}${NC}"
}

is_terraform_init_current() {
    local dir="$1"
    local init_state_file="$dir/.terraform/terraform.tfstate"
    local backend_file="$dir/backend.tf"

    [[ -f "$init_state_file" ]] || return 1

    # Re-init if backend config was edited after the last init metadata write.
    if [[ -f "$backend_file" && "$backend_file" -nt "$init_state_file" ]]; then
        return 1
    fi

    return 0
}

confirm_yes_no() {
    local prompt="$1"
    local answer

    if [[ "${AUTO_YES:-0}" -eq 1 ]]; then
        echo -e "${prompt}${CYAN}y (auto via -y)${NC}"
        return 0
    fi

    echo -en "$prompt"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

# ========================================
# Backend Bootstrap Functions
# ========================================
run_backend_init_command() {
    local bootstrap_dir="modules/bootstrap"
    local dev_env="dev"
    local -a dev_prereq_services=("networking" "ecr")
    local service

    if [[ $# -gt 0 ]]; then
        echo -e "${RED}ERROR: Command does not take arguments${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy be-init${NC}"
        return 1
    fi

    if [[ ! -d "$bootstrap_dir" ]]; then
        echo -e "${RED}ERROR: Bootstrap directory not found: $bootstrap_dir${NC}"
        return 1
    fi

    validate_environment "$dev_env" || return 1
    for service in "${dev_prereq_services[@]}"; do
        validate_service "$dev_env" "$service" || return 1
    done

    echo -e "${BLUE}Initializing backend via bootstrap stack...${NC}"

    print_terraform_command "terraform -chdir=$bootstrap_dir init"
    terraform -chdir="$bootstrap_dir" init

    print_terraform_command "terraform -chdir=$bootstrap_dir validate"
    terraform -chdir="$bootstrap_dir" validate

    print_terraform_command "terraform -chdir=$bootstrap_dir plan"
    terraform -chdir="$bootstrap_dir" plan

    if [[ "${AUTO_YES:-0}" -eq 1 ]]; then
        print_terraform_command "terraform -chdir=$bootstrap_dir apply -auto-approve"
        terraform -chdir="$bootstrap_dir" apply -auto-approve
    else
        print_terraform_command "terraform -chdir=$bootstrap_dir apply"
        terraform -chdir="$bootstrap_dir" apply
    fi

    echo -e "${YELLOW}Deploy these prerequisite services first:${NC}"
    for service in "${dev_prereq_services[@]}"; do
        echo "  ./an-deploy dev $service"
    done

    if ! confirm_yes_no "Run these DEV prerequisite deploys now? (y/n): "; then
        echo -e "${YELLOW}Skipped DEV prerequisite deploys.${NC}"
        echo -e "${YELLOW}Run the commands above before ./an-deploy dev-plan eks${NC}"
        echo -e "${GREEN}====== Backend init completed via ${bootstrap_dir}${NC}"
        return 0
    fi

    echo -e "${BLUE}Deploying DEV prerequisite services...${NC}"
    echo -e "${YELLOW}Order:${NC} ${dev_prereq_services[*]}"
    for service in "${dev_prereq_services[@]}"; do
        run_service_plan "$dev_env" "$service"
        run_service_apply "$dev_env" "$service"
    done

    echo -e "${GREEN}====== Backend init + DEV prerequisites completed!${NC}"

    local uat_env="uat"
    local -a uat_ecr_services=("ecr")
    local uat_confirm

    if [[ -d "$(service_dir "$uat_env" "ecr")" ]]; then
        echo ""
        echo -e "${YELLOW}UAT detected. Deploy UAT ECR prerequisites now?${NC}"
        echo -e "${CYAN}Creates: uat-demo-backend, uat-demo-frontend, uat-mongo-rotator${NC}"
        if confirm_yes_no "Deploy UAT ECR prerequisites now? (y/n): "; then
            echo -e "${BLUE}Deploying UAT ECR service...${NC}"
            run_service_plan "$uat_env" "ecr"
            run_service_apply "$uat_env" "ecr"
            echo -e "${GREEN}====== UAT ECR prerequisites completed!${NC}"
        else
            echo -e "${YELLOW}Skipped UAT ECR deploy.${NC}"
            echo -e "${YELLOW}Run later: ./an-deploy uat ecr${NC}"
        fi
    fi
}

get_env_state_bucket() {
    local env="$1"
    local services=()
    local service
    local bucket=""

    get_services "$env" services
    for service in "${services[@]}"; do
        bucket="$(get_backend_config_value "$env" "$service" "bucket" || true)"
        if [[ -n "$bucket" ]]; then
            echo "$bucket"
            return 0
        fi
    done

    return 1
}

bucket_has_any_versions_or_markers() {
    local bucket="$1"
    local versions
    local markers

    versions="$(aws s3api list-object-versions --bucket "$bucket" --max-items 1 --query 'length(Versions)' --output text 2>/dev/null || echo "0")"
    markers="$(aws s3api list-object-versions --bucket "$bucket" --max-items 1 --query 'length(DeleteMarkers)' --output text 2>/dev/null || echo "0")"

    [[ "$versions" != "0" && "$versions" != "None" ]] && return 0
    [[ "$markers" != "0" && "$markers" != "None" ]] && return 0
    return 1
}

delete_bucket_prefix_versions() {
    local bucket="$1"
    local prefix="$2"
    local key
    local version
    local folder
    local deleted_any
    local loop_count=0
    local batch_versions=0
    local batch_markers=0
    local total_versions=0
    local total_markers=0
    local -A seen_folders=()

    echo -e "${BLUE}Scanning prefix:${NC} s3://${bucket}/${prefix}"

    while true; do
        deleted_any=0
        batch_versions=0
        batch_markers=0

        while read -r key version; do
            [[ -z "${key:-}" || -z "${version:-}" ]] && continue
            [[ "$key" == "None" || "$version" == "None" ]] && continue

            folder="${key%/*}"
            if [[ -n "$folder" && -z "${seen_folders[$folder]+x}" ]]; then
                echo -e "${CYAN}Deleting folder:${NC} ${folder}/"
                seen_folders["$folder"]=1
            fi

            aws s3api delete-object --bucket "$bucket" --key "$key" --version-id "$version" >/dev/null
            deleted_any=1
            ((batch_versions++))
            ((total_versions++))
        done < <(aws s3api list-object-versions --bucket "$bucket" --prefix "$prefix" --query 'Versions[].[Key,VersionId]' --output text 2>/dev/null || true)

        while read -r key version; do
            [[ -z "${key:-}" || -z "${version:-}" ]] && continue
            [[ "$key" == "None" || "$version" == "None" ]] && continue

            folder="${key%/*}"
            if [[ -n "$folder" && -z "${seen_folders[$folder]+x}" ]]; then
                echo -e "${CYAN}Deleting folder:${NC} ${folder}/"
                seen_folders["$folder"]=1
            fi

            aws s3api delete-object --bucket "$bucket" --key "$key" --version-id "$version" >/dev/null
            deleted_any=1
            ((batch_markers++))
            ((total_markers++))
        done < <(aws s3api list-object-versions --bucket "$bucket" --prefix "$prefix" --query 'DeleteMarkers[].[Key,VersionId]' --output text 2>/dev/null || true)

        ((loop_count++))
        if [[ $deleted_any -eq 0 ]]; then
            break
        fi

        echo -e "${BLUE}Progress:${NC} pass=${loop_count} deleted_versions=${total_versions} deleted_markers=${total_markers}"

        if [[ $loop_count -gt 10000 ]]; then
            echo -e "${RED}ERROR: Safety stop while deleting versioned objects under s3://${bucket}/${prefix}${NC}"
            return 1
        fi
    done

    echo -e "${GREEN}Delete summary:${NC} versions=${total_versions}, delete_markers=${total_markers}"
    return 0
}

run_env_bootstrap_destroy_command() {
    local env="$1"
    shift || true

    local env_name
    local bootstrap_dir="modules/bootstrap"
    local bucket
    local prefix
    local confirm
    local destroy_bucket

    env_name="$(env_upper "$env")"

    if [[ $# -gt 0 ]]; then
        echo -e "${RED}ERROR: Command does not take arguments${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy ${env}-destroy bootstrap${NC}"
        return 1
    fi

    validate_environment "$env" || return 1

    bucket="$(get_env_state_bucket "$env" || true)"
    if [[ -z "$bucket" ]]; then
        echo -e "${RED}ERROR: Unable to detect backend bucket for env '$env'${NC}"
        return 1
    fi

    prefix="${env}/services/"

    echo -e "${RED}This removes all versioned Terraform state objects for ${env_name} under:${NC}"
    echo -e "  ${CYAN}s3://${bucket}/${prefix}${NC}"
    echo -e "${YELLOW}Recommended first:${NC} ./an-deploy ${env}-destroy all"
    echo -en "Type '${RED}DELETE ${env_name} BOOTSTRAP${NC}' to confirm: "
    read -r confirm
    if [[ "$confirm" != "DELETE ${env_name} BOOTSTRAP" ]]; then
        echo -e "${YELLOW}Operation cancelled${NC}"
        return 1
    fi

    echo -e "${BLUE}Deleting versioned backend objects for ${CYAN}${env}${NC}..."
    delete_bucket_prefix_versions "$bucket" "$prefix" || return 1
    echo -e "${GREEN}Removed backend state objects under s3://${bucket}/${prefix}${NC}"

    if bucket_has_any_versions_or_markers "$bucket"; then
        echo -e "${YELLOW}Shared backend bucket still contains data for other environments.${NC}"
        echo -e "${YELLOW}Skipped shared bootstrap bucket destroy.${NC}"
        return 0
    fi

    echo -e "${YELLOW}Bucket ${bucket} is now empty across all envs.${NC}"
    read -r -p "Delete this bucket now? (y/n): " destroy_bucket
    if [[ ! "$destroy_bucket" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Skipped shared bootstrap stack destroy.${NC}"
        return 0
    fi

    if [[ ! -d "$bootstrap_dir" ]]; then
        echo -e "${RED}ERROR: Bootstrap directory not found: $bootstrap_dir${NC}"
        return 1
    fi

    print_terraform_command "terraform -chdir=$bootstrap_dir init"
    terraform -chdir="$bootstrap_dir" init

    print_terraform_command "terraform -chdir=$bootstrap_dir validate"
    terraform -chdir="$bootstrap_dir" validate

    print_terraform_command "terraform -chdir=$bootstrap_dir destroy -var-file=terraform.tfvars"
    terraform -chdir="$bootstrap_dir" destroy -var-file=terraform.tfvars

    echo -e "${GREEN}====== Shared bootstrap stack destroyed${NC}"
}


# ========================================
# Discovery Functions
# ========================================
get_services() {
    local env="$1"
    local out_name="$2"
    local -n out_ref="$out_name"
    local services_root="envs/$env/services"

    out_ref=()

    [[ -d "$services_root" ]] || return 0

    while IFS= read -r service; do
        out_ref+=("$service")
    done < <(find "$services_root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
}

get_union_services() {
    local out_name="$1"
    local -n out_ref="$out_name"
    local env
    local services=()
    local service

    out_ref=()

    for env in "${ENVIRONMENTS[@]}"; do
        get_services "$env" services
        for service in "${services[@]}"; do
            if ! array_contains "$service" "${out_ref[@]}"; then
                out_ref+=("$service")
            fi
        done
    done

    if [[ ${#out_ref[@]} -gt 0 ]]; then
        mapfile -t out_ref < <(printf '%s\n' "${out_ref[@]}" | sort)
    fi
}

# ========================================
# Validation Functions
# ========================================
validate_environment() {
    local env="$1"
    local env_dir="envs/$env/services"

    if [[ ! -d "$env_dir" ]]; then
        echo -e "${RED}ERROR: Environment directory not found: $env_dir${NC}"
        return 1
    fi

    return 0
}

validate_service() {
    local env="$1"
    local service="$2"
    local dir
    dir="$(service_dir "$env" "$service")"

    if [[ ! -d "$dir" ]]; then
        local services
        get_services "$env" services
        echo -e "${RED}ERROR: Service '$service' not found in env '$env'${NC}"
        if [[ ${#services[@]} -gt 0 ]]; then
            echo -e "${YELLOW}Available services in $(env_upper "$env"): ${CYAN}$(join_by ' ' "${services[@]}")${NC}"
        fi
        return 1
    fi

    return 0
}

validate_prerequisites() {
    command -v terraform >/dev/null 2>&1 || {
        echo -e "${RED}ERROR: Terraform not installed${NC}"
        return 1
    }

    command -v aws >/dev/null 2>&1 || {
        echo -e "${RED}ERROR: AWS CLI not installed${NC}"
        return 1
    }

    aws configure list >/dev/null 2>&1 || {
        echo -e "${RED}ERROR: AWS credentials not configured${NC}"
        return 1
    }

    local cache_file="$HOME/.aws/credentials_cache"
    if [[ -f "$cache_file" ]] && [[ -z "$(find "$cache_file" -mmin +60 2>/dev/null)" ]]; then
        return 0
    fi

    aws sts get-caller-identity >/dev/null 2>&1 || {
        echo -e "${RED}ERROR: AWS credentials are invalid or expired${NC}"
        return 1
    }

    touch "$cache_file"
    return 0
}

validate_multi_service_args() {
    local env="$1"
    local command_usage="$2"
    local max_services="$3"
    local out_name="$4"
    shift 4

    local -n out_ref="$out_name"
    local service

    out_ref=()

    for service in "$@"; do
        [[ -n "$service" ]] && out_ref+=("$service")
    done

    if [[ ${#out_ref[@]} -eq 0 ]]; then
        echo -e "${RED}ERROR: At least one service is required${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy $command_usage <service1> [service2]${NC}"
        return 1
    fi

    if [[ ${#out_ref[@]} -gt $max_services ]]; then
        echo -e "${RED}ERROR: Maximum $max_services services allowed per operation${NC}"
        echo -e "${YELLOW}Requested services: ${out_ref[*]}${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy $command_usage <service1> [service2]${NC}"
        return 1
    fi

    for service in "${out_ref[@]}"; do
        validate_service "$env" "$service" || return 1
    done

    return 0
}

validate_uat_blocked_service() {
    local env="$1"
    local service="$2"
    local -a blocked_services=("networking" "eks" "eks-alb" "eks-post")

    [[ "$env" == "uat" ]] || return 0

    if array_contains "$service" "${blocked_services[@]}"; then
        echo -e "${RED}ERROR: UAT uses shared EKS/ALB; do not apply this service for UAT.${NC}"
        echo -e "${YELLOW}Blocked services for UAT: ${blocked_services[*]}${NC}"
        echo -e "${YELLOW}Allowed services for UAT: ecr secrets${NC}"
        return 1
    fi

    return 0
}

validate_uat_blocked_services() {
    local env="$1"
    shift
    local service

    [[ "$env" == "uat" ]] || return 0

    for service in "$@"; do
        validate_uat_blocked_service "$env" "$service" || return 1
    done

    return 0
}

# ========================================
# No-Arguments Validation
# ========================================
validate_no_args() {
    local command_usage="$1"
    shift
    if [[ $# -gt 0 ]]; then
        echo -e "${RED}ERROR: Command does not take arguments${NC}"
        echo -e "${YELLOW}Usage: ./an-deploy ${command_usage}${NC}"
        return 1
    fi
    return 0
}

# ========================================
# Dependency Resolution Functions
# ========================================
detect_remote_state_refs() {
    local env="$1"
    local service="$2"
    local dir
    local pattern

    dir="$(service_dir "$env" "$service")"
    pattern="[A-Za-z0-9_-]+/services/[A-Za-z0-9_-]+/terraform.tfstate"

    grep -RhoE "$pattern" "$dir" --include='*.tf' --exclude='backend.tf' 2>/dev/null \
        | sed -E 's#([A-Za-z0-9_-]+)/services/([^/]+)/terraform.tfstate#\1/\2#' \
        | grep -v "^${env}/${service}$" \
        | sort -u || true
}

detect_service_dependencies() {
    local env="$1"
    local service="$2"
    local refs=()
    local ref
    local ref_env
    local ref_service

    mapfile -t refs < <(detect_remote_state_refs "$env" "$service")

    for ref in "${refs[@]}"; do
        ref_env="${ref%%/*}"
        ref_service="${ref#*/}"
        if [[ "$ref_env" == "$env" && "$ref_service" != "$service" ]]; then
            echo "$ref_service"
        fi
    done | sort -u
}

backend_tf_path() {
    local env="$1"
    local service="$2"
    echo "$(service_dir "$env" "$service")/backend.tf"
}

get_backend_config_value() {
    local env="$1"
    local service="$2"
    local key_name="$3"
    local backend_file

    backend_file="$(backend_tf_path "$env" "$service")"
    [[ -f "$backend_file" ]] || return 1

    awk -F'"' -v key="$key_name" '$0 ~ key"[[:space:]]*=" { print $2; exit }' "$backend_file"
}

service_state_exists() {
    local env="$1"
    local service="$2"
    local bucket
    local key

    bucket="$(get_backend_config_value "$env" "$service" "bucket")"
    key="$(get_backend_config_value "$env" "$service" "key")"

    [[ -n "$bucket" && -n "$key" ]] || return 1
    aws s3api head-object --bucket "$bucket" --key "$key" >/dev/null 2>&1
}

check_remote_state_dependencies() {
    local env="$1"
    local service="$2"
    local refs=()
    local ref
    local ref_env
    local ref_service
    local bucket
    local key
    local -a missing_refs=()
    local -a same_env_missing=()
    local -a same_env_order=()
    local -a cross_env_missing=()
    local item

    mapfile -t refs < <(detect_remote_state_refs "$env" "$service")
    [[ ${#refs[@]} -gt 0 ]] || return 0

    for ref in "${refs[@]}"; do
        ref_env="${ref%%/*}"
        ref_service="${ref#*/}"

        if service_state_exists "$ref_env" "$ref_service"; then
            continue
        fi

        bucket="$(get_backend_config_value "$ref_env" "$ref_service" "bucket" || true)"
        key="$(get_backend_config_value "$ref_env" "$ref_service" "key" || true)"

        if [[ -n "$bucket" && -n "$key" ]]; then
            missing_refs+=("${ref} -> s3://${bucket}/${key}")
        else
            missing_refs+=("${ref} -> missing backend.tf or backend bucket/key")
        fi

        if [[ "$ref_env" == "$env" ]]; then
            if ! array_contains "$ref_service" "${same_env_missing[@]}"; then
                same_env_missing+=("$ref_service")
            fi
        else
            if ! array_contains "$ref" "${cross_env_missing[@]}"; then
                cross_env_missing+=("$ref")
            fi
        fi
    done

    if [[ ${#missing_refs[@]} -eq 0 ]]; then
        return 0
    fi

    echo -e "${RED}ERROR: Missing remote state required by ${env}/${service}${NC}"
    for item in "${missing_refs[@]}"; do
        echo -e "  - ${YELLOW}${item}${NC}"
    done

    if [[ ${#same_env_missing[@]} -gt 0 ]]; then
        resolve_service_order "$env" same_env_order "${same_env_missing[@]}"
        echo -e "${YELLOW}Deploy these prerequisite services first:${NC}"
        for item in "${same_env_order[@]}"; do
            echo -e "  ./an-deploy ${env} ${item}"
        done
    fi

    if [[ ${#cross_env_missing[@]} -gt 0 ]]; then
        echo -e "${YELLOW}Missing cross-environment prerequisite states:${NC}"
        for item in "${cross_env_missing[@]}"; do
            echo -e "  ./an-deploy ${item%%/*} ${item#*/}"
        done
    fi

    return 1
}

resolve_service_order() {
    local env="$1"
    local out_name="$2"
    shift 2

    local -n out_ref="$out_name"
    local -a targets=("$@")
    local -a remaining=("$@")
    local -a resolved_order=()
    local -a next_remaining=()
    local -a deps=()
    local -a sorted_remaining=()
    local service
    local dep
    local ready
    local progressed

    out_ref=()

    while [[ ${#remaining[@]} -gt 0 ]]; do
        progressed=0
        next_remaining=()

        for service in "${remaining[@]}"; do
            mapfile -t deps < <(detect_service_dependencies "$env" "$service")
            ready=1

            for dep in "${deps[@]}"; do
                if array_contains "$dep" "${targets[@]}" && ! array_contains "$dep" "${resolved_order[@]}"; then
                    ready=0
                    break
                fi
            done

            if [[ $ready -eq 1 ]]; then
                resolved_order+=("$service")
                progressed=1
            else
                next_remaining+=("$service")
            fi
        done

        if [[ $progressed -eq 0 ]]; then
            echo -e "${YELLOW}WARNING: Could not fully infer dependency order. Falling back to alphabetical for:${NC} ${next_remaining[*]}"
            mapfile -t sorted_remaining < <(printf '%s\n' "${next_remaining[@]}" | sort)
            resolved_order+=("${sorted_remaining[@]}")
            break
        fi

        remaining=("${next_remaining[@]}")
    done

    out_ref=("${resolved_order[@]}")
}

expand_deploy_targets() {
    local env="$1"
    local out_name="$2"
    shift 2

    local -n out_ref="$out_name"
    local -a original=("${out_ref[@]}")
    local service

    out_ref=()
    for service in "${original[@]}"; do
        if [[ "$env" == "dev" && "$service" == "eks" ]]; then
            if ! array_contains "eks" "${out_ref[@]}"; then
                out_ref+=("eks")
            fi
            if [[ -d "$(service_dir "$env" "eks-post")" ]] && ! array_contains "eks-post" "${out_ref[@]}"; then
                out_ref+=("eks-post")
            fi
            continue
        fi

        if ! array_contains "$service" "${out_ref[@]}"; then
            out_ref+=("$service")
        fi
    done
}

reverse_services() {
    local out_name="$1"
    shift

    local -n out_ref="$out_name"
    local -a arr=("$@")
    local i

    out_ref=()
    for ((i=${#arr[@]}-1; i>=0; i--)); do
        out_ref+=("${arr[$i]}")
    done
}

# ========================================
# Terraform Service Functions
# ========================================
run_service_init() {
    local env="$1"
    local service="$2"
    local dir

    dir="$(service_dir "$env" "$service")"

    if is_terraform_init_current "$dir"; then
        echo -e "${BLUE}Skipping init for service: ${CYAN}${env}/${service}${NC} ${YELLOW}(already initialized)${NC}"
        return 0
    fi

    echo -e "${BLUE}Initializing service: ${CYAN}${env}/${service}${NC}"
    print_terraform_command "terraform -chdir=$dir init"
    terraform -chdir="$dir" init
}

run_service_validate() {
    local env="$1"
    local service="$2"
    local dir

    dir="$(service_dir "$env" "$service")"

    echo -e "${BLUE}Validating service: ${CYAN}${env}/${service}${NC}"
    print_terraform_command "terraform -chdir=$dir validate"
    terraform -chdir="$dir" validate
}

run_service_plan() {
    local env="$1"
    local service="$2"
    local dir
    local tfplan

    dir="$(service_dir "$env" "$service")"
    tfplan="$(plan_name "$service")"

    if [[ "$env" == "uat" && "$service" == "secrets" ]]; then
        echo -e "${YELLOW}Prerequisite:${NC} shared namespace stack must already own/create namespace ${CYAN}uat${NC}"
        echo -e "${YELLOW}Run first if needed:${NC} ./an-deploy dev eks-alb"
    fi

    echo -e "${BLUE}Planning service: ${CYAN}${env}/${service}${NC}"
    check_remote_state_dependencies "$env" "$service" || return 1
    run_service_init "$env" "$service"

    if [[ -f "$dir/terraform.tfvars" ]]; then
