{
  "uid": "demo-uat-app-cpu-resources",
  "title": "App CPU Resources",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Uat Container CPU usage percent by app",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "(sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"uat\", pod=~\"(frontend|backend|mongo).*\", container=~\"frontend|backend|mongo\"}[5m]))) * 100",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Uat Frontend CPU percent",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{namespace=\"uat\", pod=~\"frontend.*\", container=\"frontend\"}[5m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "stat",
      "title": "Uat Backend API CPU percent",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{namespace=\"uat\", pod=~\"backend.*\", container=\"backend\"}[5m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 9
      }
    },
    {
      "type": "stat",
      "title": "Uat MongoDB CPU percent",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{namespace=\"uat\", pod=~\"mongo.*\", container=\"mongo\"}[5m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 9
      }
    }
  ]
}
