{
  "uid": "loki-resources",
  "title": "Loki Resources",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Loki CPU cores",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"monitor\", pod=~\"loki.*\", container=\"loki\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Loki memory usage",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"monitor\", pod=~\"loki.*\", container=\"loki\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 187904819,
                "color": "yellow"
              },
              {
                "value": 228170137,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "stat",
      "title": "Loki PVC used percent",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"monitor\", persistentvolumeclaim=\"loki-data\"} / kubelet_volume_stats_capacity_bytes{namespace=\"monitor\", persistentvolumeclaim=\"loki-data\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 0.70,
                "color": "yellow"
              },
              {
                "value": 0.85,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 9
      }
    },
    {
      "type": "stat",
      "title": "Loki PVC used bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"monitor\", persistentvolumeclaim=\"loki-data\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 3758096384,
                "color": "yellow"
              },
              {
                "value": 4563402752,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Loki PVC used vs capacity",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"monitor\", persistentvolumeclaim=\"loki-data\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"monitor\", persistentvolumeclaim=\"loki-data\"}",
          "legendFormat": "capacity",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      }
    }
  ]
}
